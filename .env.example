# Version 3 narratives are deterministic; generative providers are outside the
# validated core and cannot alter evidence, scores, gates, or verdicts.
AI_PROVIDER=off

# Telegram Bot API Token
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Required by the free Cloud Run webhook deployment. Generate a random value;
# allowed characters are A-Z, a-z, 0-9, underscore and hyphen.
TELEGRAM_WEBHOOK_SECRET=replace_with_a_long_random_value
TELEGRAM_REQUEST_TIMEOUT=20

# Free-tier bot safeguards. Full backtests are intentionally off on interactive
# requests and remain available only through offline research workflows.
BOT_ENABLE_BACKTEST=false
BOT_SCAN_LIMIT=10
YAHOO_REQUEST_TIMEOUT=12

# Backtests remain gross RESEARCH_ONLY unless every cost field is configured.
BROKER_COST_PROFILE=example-broker-v1
BROKER_BUY_COMMISSION=0.0015
BROKER_SELL_COMMISSION=0.0025
BROKER_SELL_LEVY=0.001
BROKER_HALF_SPREAD=0.0005
BROKER_SLIPPAGE_BPS=5
BROKER_MAX_VOLUME_PARTICIPATION=0.05

# Supabase session-pooler URL. Railway receives only this read-only credential.
SUPABASE_DATABASE_URL=postgresql://pasticuan_bot_login.PROJECT_REF:password@pooler.example:5432/postgres?sslmode=require
SUPABASE_CONNECT_TIMEOUT=3
# Scheduled jobs only; never configure this variable on Railway.
SUPABASE_WRITER_DATABASE_URL=postgresql://pasticuan_jobs_login.PROJECT_REF:password@pooler.example:5432/postgres?sslmode=require
RESEARCH_SNAPSHOT_PATH=data/snapshots/latest.json.gz
SCAN_SNAPSHOT_TTL_SECONDS=300
BOT_SNAPSHOT_ONLY=true

# Optional immutable raw-document and pg_dump archive.
R2_ENDPOINT_URL=https://account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=replace_me
R2_SECRET_ACCESS_KEY=replace_me
R2_BUCKET=pasticuan-research
# Generate once with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
BACKUP_ENCRYPTION_KEY=replace_with_fernet_key

# Optional immutable-snapshot verification. GitHub receives the private key;
# Railway receives only the public key and key ID.
SNAPSHOT_ED25519_PUBLIC_KEY=
# Scheduled jobs only; never configure the private key on Railway.
SNAPSHOT_ED25519_PRIVATE_KEY=
SNAPSHOT_SIGNING_KEY_ID=primary
SNAPSHOT_CACHE_TTL_SECONDS=300
