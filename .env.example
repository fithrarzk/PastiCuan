# AI provider: ollama, gemini, auto, or off.
# Local-first default is Ollama.
AI_PROVIDER=ollama

# Ollama local server settings.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT=180
OLLAMA_TEMPERATURE=0.2
OLLAMA_NUM_CTX=4096

# Optional cloud fallback. Only used when AI_PROVIDER=gemini or AI_PROVIDER=auto.
GEMINI_API_KEY=your_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Telegram Bot API Token
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Required by the free Cloud Run webhook deployment. Generate a random value;
# allowed characters are A-Z, a-z, 0-9, underscore and hyphen.
TELEGRAM_WEBHOOK_SECRET=replace_with_a_long_random_value

# Free-tier bot safeguards. Full backtests are intentionally off on interactive
# requests; the Streamlit app still provides the research backtest tab.
BOT_ENABLE_BACKTEST=false
BOT_SCAN_LIMIT=10
YAHOO_REQUEST_TIMEOUT=12

# Shared production persistence. Original filings belong in S3-compatible
# object storage; only immutable keys and checksums are stored in PostgreSQL.
DATABASE_URL=postgresql://user:password@host:5432/pasticuan
OBJECT_STORAGE_ENDPOINT=https://s3.example.com
OBJECT_STORAGE_BUCKET=pasticuan-filings

# Backtests remain gross RESEARCH_ONLY unless every cost field is configured.
BROKER_COST_PROFILE=example-broker-v1
BROKER_BUY_COMMISSION=0.0015
BROKER_SELL_COMMISSION=0.0025
BROKER_SELL_LEVY=0.001
BROKER_HALF_SPREAD=0.0005
BROKER_SLIPPAGE_BPS=5
BROKER_MAX_VOLUME_PARTICIPATION=0.05

# Keep closed until walk-forward/holdout acceptance is recorded.
MODEL_VALIDATED=false
SHADOW_COMPLETED_SESSIONS=0
